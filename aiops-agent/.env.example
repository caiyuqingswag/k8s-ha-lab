# Service
AIOPS_ENV=dev
AIOPS_LOG_LEVEL=INFO
AIOPS_DRY_RUN=true

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://api.openai.com/v1

# Observability endpoints. Replace these with real environment URLs later.
PROMETHEUS_URL=http://prometheus.example.local
LOKI_URL=http://loki.example.local
TEMPO_URL=http://tempo.example.local
GRAFANA_URL=http://grafana.example.local

# Kubernetes access
KUBERNETES_MODE=in_cluster
KUBECONFIG_PATH=
DEFAULT_NAMESPACE=default

# Execution policy
ALLOW_AUTO_EXECUTE_LOW_RISK=true
REQUIRE_APPROVAL_FOR_MEDIUM_RISK=true
DENY_HIGH_RISK_EXECUTION=true

# Persistence placeholders for next phase
POSTGRES_DSN=postgresql://aiops:CHANGE_ME@postgres.example.local:5432/aiops
REDIS_URL=redis://redis.example.local:6379/0
QDRANT_URL=http://qdrant.example.local:6333
