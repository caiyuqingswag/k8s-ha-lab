# ===============================
# Istio Local Rate Limit EnvoyFilters
# Generated by Ansible
# ===============================

{% if istio_rate_limit_enabled | bool %}
{% for policy in istio_local_rate_limit_policies %}
---
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: {{ policy.name }}
  namespace: {{ policy.namespace }}
spec:
  workloadSelector:
    labels:
{% for k, v in policy.workloadSelector.items() %}
      {{ k }}: {{ v }}
{% endfor %}
  configPatches:
    - applyTo: HTTP_FILTER
      match:
        context: {{ policy.context }}
        listener:
          portNumber: {{ policy.portNumber }}
          filterChain:
            filter:
              name: envoy.filters.network.http_connection_manager
              subFilter:
                name: envoy.filters.http.router
      patch:
        operation: INSERT_BEFORE
        value:
          name: envoy.filters.http.local_ratelimit
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
            stat_prefix: {{ policy.statPrefix }}
            token_bucket:
              max_tokens: {{ policy.maxTokens }}
              tokens_per_fill: {{ policy.tokensPerFill }}
              fill_interval: {{ policy.fillInterval }}
            filter_enabled:
              runtime_key: local_rate_limit_enabled
              default_value:
                numerator: {{ policy.enabledPercent | default(100) }}
                denominator: HUNDRED
            filter_enforced:
              runtime_key: local_rate_limit_enforced
              default_value:
                numerator: {{ policy.enforcedPercent | default(100) }}
                denominator: HUNDRED
            status:
              code: {{ policy.statusCodeName | default('TooManyRequests') }}
{% if policy.responseHeaders is defined and policy.responseHeaders | length > 0 %}
            response_headers_to_add:
{% for header in policy.responseHeaders %}
              - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                header:
                  key: {{ header.key }}
                  value: "{{ header.value }}"
{% endfor %}
{% endif %}

{% endfor %}
{% endif %}
