---
core:
  replicas: {{ jumpserver_replicas }}
  adminPassword: "{{ jumpserver_admin_password }}"
  secretKey: "{{ jumpserver_secret_key }}"

postgres:
  enabled: {{ "false" if jumpserver_postgres_external else "true" }}
  host: "{{ jumpserver_postgres_host }}"
  port: {{ jumpserver_postgres_port }}
  username: "{{ jumpserver_postgres_user }}"
  password: "{{ jumpserver_postgres_password }}"
  database: "{{ jumpserver_postgres_db }}"

redis:
  enabled: {{ "false" if jumpserver_redis_external else "true" }}
  host: "{{ jumpserver_redis_host }}"
  port: {{ jumpserver_redis_port }}
  password: "{{ jumpserver_redis_password }}"

hostname: "{{ jumpserver_hostname }}"

ingress:
  enabled: false

resources:
  requests:
    cpu: "250m"
    memory: "512Mi"
  limits:
    cpu: "2"
    memory: "2Gi"

antiAffinity: "preferred"