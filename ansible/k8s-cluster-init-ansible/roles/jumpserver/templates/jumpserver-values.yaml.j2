# ===============================
# JumpServer Helm values
# Generated by Ansible
# ===============================

global:
  imageRegistry: "{{ jumpserver_image_registry }}"
  imageOwner: "{{ jumpserver_image_owner }}"
  imagePullSecrets: []
  storageClass: "{{ jumpserver_storage_class }}"

externalDatabase:
  engine: "{{ jumpserver_external_database_engine }}"
  host: "{{ jumpserver_external_database_host }}"
  port: {{ jumpserver_external_database_port }}
  user: "{{ jumpserver_external_database_user }}"
  password: "{{ jumpserver_external_database_password }}"
  database: "{{ jumpserver_external_database_name }}"

externalRedis:
  host: "{{ jumpserver_external_redis_host }}"
  port: {{ jumpserver_external_redis_port }}
  password: "{{ jumpserver_external_redis_password }}"

ingress:
  enabled: {{ jumpserver_ingress_enabled | bool | lower }}
  hosts:
    - "{{ jumpserver_hostname }}"

core:
  enabled: true
  replicaCount: {{ jumpserver_core_replicas }}
  config:
    secretKey: "{{ jumpserver_core_secret_key }}"
    bootstrapToken: "{{ jumpserver_core_bootstrap_token }}"
    debug: false
    log:
      level: ERROR
  env:
    DOMAINS: "{{ jumpserver_core_domains }}"
    SESSION_EXPIRE_AT_BROWSER_CLOSE: true
  service:
    type: ClusterIP
    web:
      port: 8080
  resources:
    requests:
      cpu: "{{ jumpserver_core_cpu_request }}"
      memory: "{{ jumpserver_core_memory_request }}"
    limits:
      cpu: "{{ jumpserver_core_cpu_limit }}"
      memory: "{{ jumpserver_core_memory_limit }}"
  persistence:
    storageClassName: "{{ jumpserver_storage_class }}"
    accessModes:
      - "{{ jumpserver_access_mode }}"
    size: "{{ jumpserver_core_persistence_size }}"

web:
  enabled: true
  replicaCount: {{ jumpserver_web_replicas }}
  env:
    CLIENT_MAX_BODY_SIZE: 4096m
    USE_LB: "{{ jumpserver_web_use_lb }}"
  service:
    type: ClusterIP
    web:
      port: 80
  resources:
    requests:
      cpu: "{{ jumpserver_web_cpu_request }}"
      memory: "{{ jumpserver_web_memory_request }}"
    limits:
      cpu: "{{ jumpserver_web_cpu_limit }}"
      memory: "{{ jumpserver_web_memory_limit }}"
  persistence:
    storageClassName: "{{ jumpserver_storage_class }}"
    accessModes:
      - "{{ jumpserver_access_mode }}"
    size: "{{ jumpserver_web_persistence_size }}"

koko:
  enabled: true
  replicaCount: {{ jumpserver_koko_replicas }}
  service:
    type: ClusterIP
    web:
      port: 5000
    ssh:
      port: 2222
  resources:
    requests:
      cpu: "{{ jumpserver_koko_cpu_request }}"
      memory: "{{ jumpserver_koko_memory_request }}"
    limits:
      cpu: "{{ jumpserver_koko_cpu_limit }}"
      memory: "{{ jumpserver_koko_memory_limit }}"
  persistence:
    storageClassName: "{{ jumpserver_storage_class }}"
    accessModes:
      - "{{ jumpserver_access_mode }}"
    size: "{{ jumpserver_koko_persistence_size }}"

lion:
  enabled: true
  replicaCount: {{ jumpserver_lion_replicas }}
  service:
    type: ClusterIP
    web:
      port: 8081
  resources:
    requests:
      cpu: "{{ jumpserver_lion_cpu_request }}"
      memory: "{{ jumpserver_lion_memory_request }}"
    limits:
      cpu: "{{ jumpserver_lion_cpu_limit }}"
      memory: "{{ jumpserver_lion_memory_limit }}"
  persistence:
    storageClassName: "{{ jumpserver_storage_class }}"
    accessModes:
      - "{{ jumpserver_access_mode }}"
    size: "{{ jumpserver_lion_persistence_size }}"

chen:
  enabled: true
  replicaCount: {{ jumpserver_chen_replicas }}
  service:
    type: ClusterIP
    web:
      port: 8082
  resources:
    requests:
      cpu: "{{ jumpserver_chen_cpu_request }}"
      memory: "{{ jumpserver_chen_memory_request }}"
    limits:
      cpu: "{{ jumpserver_chen_cpu_limit }}"
      memory: "{{ jumpserver_chen_memory_limit }}"
  persistence:
    storageClassName: "{{ jumpserver_storage_class }}"
    accessModes:
      - "{{ jumpserver_access_mode }}"
    size: "{{ jumpserver_chen_persistence_size }}"

xpack:
  enabled: {{ jumpserver_xpack_enabled | bool | lower }}
