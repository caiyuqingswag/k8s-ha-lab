# ===============================
# JumpServer embedded dependencies
# PostgreSQL + Redis
# Generated by Ansible
# ===============================

---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ jumpserver_namespace }}

{% if jumpserver_postgresql_enabled | bool %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ jumpserver_postgresql_name }}-secret
  namespace: {{ jumpserver_namespace }}
type: Opaque
stringData:
  POSTGRES_DB: "{{ jumpserver_postgresql_database }}"
  POSTGRES_USER: "{{ jumpserver_postgresql_user }}"
  POSTGRES_PASSWORD: "{{ jumpserver_postgresql_password }}"

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ jumpserver_postgresql_name }}-data
  namespace: {{ jumpserver_namespace }}
spec:
  accessModes:
    - {{ jumpserver_access_mode }}
  storageClassName: "{{ jumpserver_storage_class }}"
  resources:
    requests:
      storage: "{{ jumpserver_postgresql_pvc_size }}"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ jumpserver_postgresql_name }}
  namespace: {{ jumpserver_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ jumpserver_postgresql_name }}
  template:
    metadata:
      labels:
        app: {{ jumpserver_postgresql_name }}
    spec:
      containers:
        - name: postgresql
          image: {{ jumpserver_postgresql_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: postgresql
              containerPort: {{ jumpserver_postgresql_port }}
          env:
            - name: POSTGRES_DB
              valueFrom:
                secretKeyRef:
                  name: {{ jumpserver_postgresql_name }}-secret
                  key: POSTGRES_DB
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: {{ jumpserver_postgresql_name }}-secret
                  key: POSTGRES_USER
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ jumpserver_postgresql_name }}-secret
                  key: POSTGRES_PASSWORD
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 5
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ jumpserver_postgresql_name }}-data

---
apiVersion: v1
kind: Service
metadata:
  name: {{ jumpserver_postgresql_name }}
  namespace: {{ jumpserver_namespace }}
spec:
  type: ClusterIP
  selector:
    app: {{ jumpserver_postgresql_name }}
  ports:
    - name: postgresql
      port: {{ jumpserver_postgresql_port }}
      targetPort: {{ jumpserver_postgresql_port }}
{% endif %}

{% if jumpserver_redis_enabled | bool %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ jumpserver_redis_name }}-secret
  namespace: {{ jumpserver_namespace }}
type: Opaque
stringData:
  REDIS_PASSWORD: "{{ jumpserver_redis_password }}"

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ jumpserver_redis_name }}-data
  namespace: {{ jumpserver_namespace }}
spec:
  accessModes:
    - {{ jumpserver_access_mode }}
  storageClassName: "{{ jumpserver_storage_class }}"
  resources:
    requests:
      storage: "{{ jumpserver_redis_pvc_size }}"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ jumpserver_redis_name }}
  namespace: {{ jumpserver_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ jumpserver_redis_name }}
  template:
    metadata:
      labels:
        app: {{ jumpserver_redis_name }}
    spec:
      containers:
        - name: redis
          image: {{ jumpserver_redis_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: redis
              containerPort: {{ jumpserver_redis_port }}
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ jumpserver_redis_name }}-secret
                  key: REDIS_PASSWORD
          command:
            - sh
            - -c
            - redis-server --appendonly yes --requirepass "$REDIS_PASSWORD"
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - redis-cli -a "$REDIS_PASSWORD" ping | grep PONG
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - redis-cli -a "$REDIS_PASSWORD" ping | grep PONG
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 5
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ jumpserver_redis_name }}-data

---
apiVersion: v1
kind: Service
metadata:
  name: {{ jumpserver_redis_name }}
  namespace: {{ jumpserver_namespace }}
spec:
  type: ClusterIP
  selector:
    app: {{ jumpserver_redis_name }}
  ports:
    - name: redis
      port: {{ jumpserver_redis_port }}
      targetPort: {{ jumpserver_redis_port }}
{% endif %}
