# ===============================
# Istio public ingress gateway
# Public CLB -> NodePort 30080
# ===============================

name: istio-ingressgateway-public

labels:
  app: istio-ingressgateway-public
  istio: ingressgateway-public

replicaCount: {{ istio_public_gateway_replicas }}

service:
  type: NodePort

  ports:
    - name: status-port
      port: 15021
      targetPort: 15021
      nodePort: {{ istio_public_status_nodeport }}
      protocol: TCP

    - name: http2
      port: 80
      targetPort: 80
      nodePort: {{ istio_public_http_nodeport }}
      protocol: TCP

    - name: https
      port: 443
      targetPort: 443
      nodePort: {{ istio_public_https_nodeport }}
      protocol: TCP

resources:
  requests:
    cpu: "{{ istio_gateway_cpu_request }}"
    memory: "{{ istio_gateway_memory_request }}"
  limits:
    cpu: "{{ istio_gateway_cpu_limit }}"
    memory: "{{ istio_gateway_memory_limit }}"
