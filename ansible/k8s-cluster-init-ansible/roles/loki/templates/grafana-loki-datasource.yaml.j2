{% if loki_create_grafana_datasource | bool %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-loki
  namespace: {{ loki_grafana_namespace }}
  labels:
    grafana_datasource: "1"
data:
  loki-datasource.yaml: |
    apiVersion: 1
    deleteDatasources:
      - name: {{ loki_grafana_datasource_name }}
        orgId: 1
    datasources:
      - name: {{ loki_grafana_datasource_name }}
        uid: {{ loki_grafana_datasource_uid }}
        type: loki
        access: proxy
        url: {{ loki_grafana_datasource_url }}
        isDefault: false
        editable: true
        version: 20
        jsonData:
          maxLines: 1000
{% endif %}