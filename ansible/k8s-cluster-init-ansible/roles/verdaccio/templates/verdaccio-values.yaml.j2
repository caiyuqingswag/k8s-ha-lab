# ===============================
# Verdaccio Helm values
# Generated by Ansible
# ===============================

type: deployment

replicaCount: 1
replicaCountEnabled: true

image:
  repository: "{{ verdaccio_image_repository }}"
{% if verdaccio_image_tag | length > 0 %}
  tag: "{{ verdaccio_image_tag }}"
{% endif %}
  pullPolicy: IfNotPresent

service:
  type: "{{ verdaccio_service_type }}"
  port: {{ verdaccio_service_port }}

ingress:
  enabled: {{ verdaccio_ingress_enabled | bool | lower }}

persistence:
  enabled: {{ verdaccio_persistence_enabled | bool | lower }}
  storageClass: "{{ verdaccio_storage_class }}"
  accessMode: "{{ verdaccio_persistence_access_mode }}"
  size: "{{ verdaccio_persistence_size }}"
  resourcePolicy: "{{ verdaccio_persistence_resource_policy }}"

resources:
  requests:
    cpu: "{{ verdaccio_cpu_request }}"
    memory: "{{ verdaccio_memory_request }}"
  limits:
    cpu: "{{ verdaccio_cpu_limit }}"
    memory: "{{ verdaccio_memory_limit }}"

securityContext:
  runAsUser: 10001

podSecurityContext:
  fsGroup: 101

extraEnvVars:
  - name: VERDACCIO_PORT
    value: "{{ verdaccio_service_port }}"
  - name: VERDACCIO_PUBLIC_URL
    value: "http://{{ verdaccio_hostname }}"

# 使用 chart 生成 htpasswd
useSecretHtpasswd: true

secrets:
  htpasswd:
{% for user in verdaccio_users %}
    - username: "{{ user.username }}"
      password: "{{ user.password }}"
{% endfor %}

configMap: |
  storage: /verdaccio/storage/data

  web:
    title: {{ verdaccio_web_title }}

  auth:
    htpasswd:
      file: /verdaccio/storage/htpasswd
      algorithm: bcrypt
      rounds: 10
      max_users: {{ verdaccio_max_users }}

  uplinks:
    npmjs:
      url: {{ verdaccio_uplink_registry }}
      agent_options:
        keepAlive: true
        maxSockets: 40
        maxFreeSockets: 10

  packages:
    '@*/*':
{% if verdaccio_allow_anonymous_access | bool %}
      access: $all
{% else %}
      access: $authenticated
{% endif %}
{% if verdaccio_publish_authenticated_only | bool %}
      publish: $authenticated
      unpublish: $authenticated
{% else %}
      publish: $all
      unpublish: $all
{% endif %}
      proxy: npmjs

    '**':
{% if verdaccio_allow_anonymous_access | bool %}
      access: $all
{% else %}
      access: $authenticated
{% endif %}
{% if verdaccio_publish_authenticated_only | bool %}
      publish: $authenticated
      unpublish: $authenticated
{% else %}
      publish: $all
      unpublish: $all
{% endif %}
      proxy: npmjs

  middlewares:
    audit:
      enabled: true

  log:
    type: stdout
    format: pretty
    level: http
