{% if istio_global_ratelimit_enabled | bool %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ istio_global_ratelimit_namespace }}

{% if istio_global_ratelimit_redis_enabled | bool %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ istio_global_ratelimit_redis_name }}
  namespace: {{ istio_global_ratelimit_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ istio_global_ratelimit_redis_name }}
  template:
    metadata:
      labels:
        app: {{ istio_global_ratelimit_redis_name }}
    spec:
      containers:
        - name: redis
          image: {{ istio_global_ratelimit_redis_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ istio_global_ratelimit_redis_port }}
              name: redis
---
apiVersion: v1
kind: Service
metadata:
  name: {{ istio_global_ratelimit_redis_name }}
  namespace: {{ istio_global_ratelimit_namespace }}
spec:
  selector:
    app: {{ istio_global_ratelimit_redis_name }}
  ports:
    - name: redis
      port: {{ istio_global_ratelimit_redis_port }}
      targetPort: {{ istio_global_ratelimit_redis_port }}
{% endif %}

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ratelimit-config
  namespace: {{ istio_global_ratelimit_namespace }}
data:
  config.yaml: |
{% for policy in istio_global_ratelimit_policies %}
{% if policy.enabled | default(true) %}
    domain: {{ policy.domain }}
    descriptors:
      - key: generic_key
        value: {{ policy.descriptorValue }}
        rate_limit:
          unit: {{ policy.unit }}
          requests_per_unit: {{ policy.requestsPerUnit }}
{% endif %}
{% endfor %}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ istio_global_ratelimit_service_name }}
  namespace: {{ istio_global_ratelimit_namespace }}
spec:
  replicas: {{ istio_global_ratelimit_replicas }}
  selector:
    matchLabels:
      app: {{ istio_global_ratelimit_service_name }}
  template:
    metadata:
      labels:
        app: {{ istio_global_ratelimit_service_name }}
    spec:
      containers:
        - name: ratelimit
          image: {{ istio_global_ratelimit_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/ratelimit
          env:
            - name: LOG_LEVEL
              value: "{{ istio_global_ratelimit_log_level }}"
            - name: USE_STATSD
              value: "false"
            - name: RUNTIME_ROOT
              value: "/data"
            - name: RUNTIME_SUBDIRECTORY
              value: "ratelimit"
            - name: RUNTIME_APPDIRECTORY
              value: "config"
            - name: RUNTIME_WATCH_ROOT
              value: "false"
            - name: RUNTIME_IGNOREDOTFILES
              value: "true"
            - name: REDIS_SOCKET_TYPE
              value: "tcp"
            - name: REDIS_URL
              value: "{{ istio_global_ratelimit_redis_name }}.{{ istio_global_ratelimit_namespace }}.svc.cluster.local:{{ istio_global_ratelimit_redis_port }}"
          ports:
            - containerPort: {{ istio_global_ratelimit_grpc_port }}
              name: grpc
            - containerPort: {{ istio_global_ratelimit_http_port }}
              name: http
          volumeMounts:
            - name: ratelimit-config
              mountPath: /data/ratelimit/config
          readinessProbe:
            httpGet:
              path: /healthcheck
              port: {{ istio_global_ratelimit_http_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthcheck
              port: {{ istio_global_ratelimit_http_port }}
            initialDelaySeconds: 10
            periodSeconds: 10
      volumes:
        - name: ratelimit-config
          configMap:
            name: ratelimit-config

---
apiVersion: v1
kind: Service
metadata:
  name: {{ istio_global_ratelimit_service_name }}
  namespace: {{ istio_global_ratelimit_namespace }}
spec:
  selector:
    app: {{ istio_global_ratelimit_service_name }}
  ports:
    - name: grpc
      port: {{ istio_global_ratelimit_grpc_port }}
      targetPort: {{ istio_global_ratelimit_grpc_port }}
    - name: http
      port: {{ istio_global_ratelimit_http_port }}
      targetPort: {{ istio_global_ratelimit_http_port }}

{% for policy in istio_global_ratelimit_policies %}
{% if policy.enabled | default(true) %}
---
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: {{ policy.name }}
  namespace: {{ policy.namespace }}
spec:
  workloadSelector:
    labels:
{% for k, v in policy.workloadSelector.items() %}
      {{ k }}: {{ v }}
{% endfor %}

  configPatches:
    # 1. 给 HTTP Route 添加 rate_limits descriptor
    - applyTo: HTTP_ROUTE
      match:
        context: {{ policy.context }}
        routeConfiguration:
          vhost:
            route:
              action: ANY
      patch:
        operation: MERGE
        value:
          route:
            rate_limits:
              - actions:
                  - generic_key:
                      descriptor_value: "{{ policy.descriptorValue }}"

    # 2. 插入 Envoy global rate limit HTTP filter
    - applyTo: HTTP_FILTER
      match:
        context: {{ policy.context }}
        listener:
          portNumber: {{ policy.portNumber }}
          filterChain:
            filter:
              name: envoy.filters.network.http_connection_manager
              subFilter:
                name: envoy.filters.http.router
      patch:
        operation: INSERT_BEFORE
        value:
          name: envoy.filters.http.ratelimit
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.http.ratelimit.v3.RateLimit
            domain: "{{ policy.domain }}"
            failure_mode_deny: {{ istio_global_ratelimit_failure_mode_deny | bool | lower }}
            timeout: {{ istio_global_ratelimit_timeout }}
            rate_limit_service:
              grpc_service:
                envoy_grpc:
                  cluster_name: rate_limit_cluster
              transport_api_version: V3

    # 3. 增加 ratelimit service upstream cluster
    - applyTo: CLUSTER
      match:
        context: {{ policy.context }}
      patch:
        operation: ADD
        value:
          name: rate_limit_cluster
          type: STRICT_DNS
          connect_timeout: 10s
          lb_policy: ROUND_ROBIN
          http2_protocol_options: {}
          load_assignment:
            cluster_name: rate_limit_cluster
            endpoints:
              - lb_endpoints:
                  - endpoint:
                      address:
                        socket_address:
                          address: {{ istio_global_ratelimit_service_name }}.{{ istio_global_ratelimit_namespace }}.svc.cluster.local
                          port_value: {{ istio_global_ratelimit_grpc_port }}
{% endif %}
{% endfor %}
{% endif %}
