apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kube-vip
    app.kubernetes.io/component: control-plane-vip
spec:
  hostNetwork: true
  restartPolicy: Always
  priorityClassName: system-node-critical
  containers:
    - name: kube-vip
      image: "{{ kube_vip_image }}:{{ kube_vip_version }}"
      imagePullPolicy: IfNotPresent
      args:
        - manager
      env:
        - name: vip_arp
          value: "{{ 'true' if kube_vip_arp else 'false' }}"
        - name: port
          value: "{{ kube_vip_port | string }}"
        - name: vip_nodename
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        - name: vip_interface
          value: "{{ kube_vip_effective_interface }}"
        - name: vip_subnet
          value: "{{ kube_vip_subnet | string }}"
        - name: address
          value: "{{ kube_vip_address }}"
        - name: cp_enable
          value: "{{ 'true' if kube_vip_cp_enable else 'false' }}"
        - name: cp_namespace
          value: kube-system
        - name: vip_leaderelection
          value: "{{ 'true' if kube_vip_leader_election else 'false' }}"
        - name: vip_leasename
          value: "{{ kube_vip_lease_name_cp }}"
        - name: vip_leaseduration
          value: "{{ kube_vip_lease_duration | string }}"
        - name: vip_renewdeadline
          value: "{{ kube_vip_renew_deadline | string }}"
        - name: vip_retryperiod
          value: "{{ kube_vip_retry_period | string }}"
        # 这个 role 只做 control-plane VIP
        - name: svc_enable
          value: "{{ 'true' if kube_vip_svc_enable else 'false' }}"
        - name: lb_enable
          value: "{{ 'true' if kube_vip_lb_enable else 'false' }}"
        - name: prometheus_server
          value: "{{ kube_vip_metrics_bind }}"
      securityContext:
        capabilities:
          add:
            - NET_ADMIN
            - NET_RAW
          drop:
            - ALL
      volumeMounts:
        - mountPath: /etc/kubernetes/admin.conf
          name: kubeconfig
          readOnly: true
  hostAliases:
    - ip: 127.0.0.1
      hostnames:
        - kubernetes
  volumes:
    - name: kubeconfig
      hostPath:
        path: "{{ kube_vip_kubeconfig_path }}"
        type: FileOrCreate